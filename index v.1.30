const {
    default: makeWASocket,
    useMultiFileAuthState,
    DisconnectReason
} = require('@whiskeysockets/baileys');

const qrcode = require('qrcode-terminal');
const fs = require('fs');
const path = require('path');
const pino = require('pino');
const readline = require('readline');
const v8 = require('v8');


// =========================
// SESSION-LOGS AUSBLENDEN
// =========================

const originalConsoleLog = console.log;
const originalConsoleError = console.error;
const originalConsoleWarn = console.warn;

function shouldHideSessionLog(args) {

    const text = args
        .map(arg => {

            if (typeof arg === 'string') {
                return arg;
            }

            try {
                return JSON.stringify(arg);
            } catch {
                return String(arg);
            }
        })
        .join(' ');

    return (
        text.includes('Closing session: SessionEntry') ||
        text.includes(
            'Closing stale open session for new outgoing prekey bundle'
        ) ||
        text.includes(
            'Closing open session in favor of incoming prekey bundle'
        ) ||
        text.includes(
            'Removing old closed session'
        ) ||
        text.includes(
            'Decrypted message with closed session'
        )
    );
}


// =========================
// CONSOLE FILTER
// =========================

console.log = (...args) => {

    if (shouldHideSessionLog(args)) {
        return;
    }

    originalConsoleLog(...args);
};

console.error = (...args) => {

    if (shouldHideSessionLog(args)) {
        return;
    }

    originalConsoleError(...args);
};

console.warn = (...args) => {

    if (shouldHideSessionLog(args)) {
        return;
    }

    originalConsoleWarn(...args);
};


// =========================
// DIREKTEN STDOUT/STDERR
// FILTERN
// =========================

const originalStdoutWrite =
    process.stdout.write.bind(
        process.stdout
    );

const originalStderrWrite =
    process.stderr.write.bind(
        process.stderr
    );

function shouldHideRawSessionLog(chunk) {

    if (
        typeof chunk !== 'string' &&
        !Buffer.isBuffer(chunk)
    ) {
        return false;
    }

    const text =
        Buffer.isBuffer(chunk)
            ? chunk.toString()
            : chunk;

    return (
        text.includes(
            'Closing session: SessionEntry'
        ) ||
        text.includes(
            'Closing stale open session for new outgoing prekey bundle'
        ) ||
        text.includes(
            'Closing open session in favor of incoming prekey bundle'
        ) ||
        text.includes(
            'Removing old closed session'
        ) ||
        text.includes(
            'Decrypted message with closed session'
        )
    );
}

process.stdout.write = function (
    chunk,
    encoding,
    callback
) {

    if (
        shouldHideRawSessionLog(
            chunk
        )
    ) {

        if (
            typeof callback ===
            'function'
        ) {
            callback();
        }

        return true;
    }

    return originalStdoutWrite(
        chunk,
        encoding,
        callback
    );
};

process.stderr.write = function (
    chunk,
    encoding,
    callback
) {

    if (
        shouldHideRawSessionLog(
            chunk
        )
    ) {

        if (
            typeof callback ===
            'function'
        ) {
            callback();
        }

        return true;
    }

    return originalStderrWrite(
        chunk,
        encoding,
        callback
    );
};


// =========================
// DATEIEN LADEN
// =========================

function loadRanks() {

    try {

        return JSON.parse(
            fs.readFileSync(
                './ranks.json',
                'utf8'
            )
        );

    } catch {

        return {};
    }
}

function saveRanks(ranks) {

    fs.writeFileSync(
        './ranks.json',
        JSON.stringify(
            ranks,
            null,
            2
        ),
        'utf8'
    );
}

function loadPrefix() {

    try {

        const data = JSON.parse(
            fs.readFileSync(
                './prefix.json',
                'utf8'
            )
        );

        if (
            typeof data.prefix === 'string' &&
            data.prefix.length > 0
        ) {
            return data.prefix;
        }

        return '!';

    } catch {

        return '!';
    }
}

function loadGroupPrefixes() {

    try {

        return JSON.parse(
            fs.readFileSync(
                './groupPrefixes.json',
                'utf8'
            )
        );

    } catch {

        return {};
    }
}

function loadMaintenance() {

    try {

        return JSON.parse(
            fs.readFileSync(
                './maintenance.json',
                'utf8'
            )
        );

    } catch {

        return {};
    }
}

function loadKilledGroups() {

    try {

        return JSON.parse(
            fs.readFileSync(
                './killedGroups.json',
                'utf8'
            )
        );

    } catch {

        return {};
    }
}

function loadGlobalKill() {

    try {

        return JSON.parse(
            fs.readFileSync(
                './globalKill.json',
                'utf8'
            )
        );

    } catch {

        return {
            enabled: false
        };
    }
}

function loadOnlyOwner() {

    try {

        return JSON.parse(
            fs.readFileSync(
                './onlyOwner.json',
                'utf8'
            )
        );

    } catch {

        return {};
    }
}


// =========================
// LID NORMALISIEREN
// =========================

function normalizeLid(lid) {

    if (!lid) {
        return null;
    }

    return (
        lid
            .split(':')[0]
            .split('@')[0] +
        '@lid'
    );
}


// =========================
// TELEFONNUMMER ERMITTELN
// =========================

async function getPhoneNumber(
    sock,
    message,
    senderLid
) {

    try {

        const directPhone =
            message.key.participantPn ||
            message.key.senderPn;

        if (
            directPhone &&
            directPhone.includes(
                '@s.whatsapp.net'
            )
        ) {

            return directPhone
                .split(':')[0]
                .split('@')[0];
        }

        if (
            senderLid &&
            senderLid.endsWith('@lid') &&
            sock.signalRepository?.lidMapping
        ) {

            const pn =
                await sock.signalRepository
                    .lidMapping
                    .getPNForLID(
                        senderLid
                    );

            if (pn) {

                return pn
                    .split(':')[0]
                    .split('@')[0];
            }
        }

    } catch (error) {

        console.error(
            '❌ Fehler beim Ermitteln der Telefonnummer:',
            error
        );
    }

    return 'unbekannt';
}


// =========================
// REACTION
// =========================

async function react(
    sock,
    message,
    emoji
) {

    try {

        await sock.sendMessage(
            message.key.remoteJid,
            {
                react: {
                    text: emoji,
                    key: message.key
                }
            }
        );

    } catch (error) {

        console.error(
            '❌ Reaction Fehler:',
            error
        );
    }
}


// =========================
// RESTART-REACTION
// =========================

async function finishRestartReaction(
    sock
) {

    const restartFile =
        path.join(
            __dirname,
            'restartReaction.json'
        );

    if (!fs.existsSync(restartFile)) {
        return;
    }

    try {

        const messageKey =
            JSON.parse(
                fs.readFileSync(
                    restartFile,
                    'utf8'
                )
            );

        await sock.sendMessage(
            messageKey.remoteJid,
            {
                react: {
                    text: '✅',
                    key: messageKey
                }
            }
        );

        fs.unlinkSync(restartFile);

        console.log(
            '✅ Neustart erfolgreich abgeschlossen.'
        );

    } catch (error) {

        console.error(
            '❌ Fehler beim Aktualisieren der Restart-Reaction:',
            error
        );
    }
}


// =========================
// COMMANDS LADEN
// =========================

const commands = {};

const commandsPath =
    path.join(
        __dirname,
        'commands'
    );

function loadCommandFiles(
    directory,
    category = null
) {

    if (!fs.existsSync(directory)) {
        return;
    }

    const entries =
        fs.readdirSync(
            directory,
            {
                withFileTypes: true
            }
        );

    for (
        const entry of entries
    ) {

        const fullPath =
            path.join(
                directory,
                entry.name
            );

        if (entry.isDirectory()) {

            const folderCategory =
                category ||
                entry.name;

            loadCommandFiles(
                fullPath,
                folderCategory
            );

            continue;
        }

        if (
            !entry.isFile() ||
            !entry.name.endsWith('.js')
        ) {
            continue;
        }

        try {

            const command =
                require(fullPath);

            if (
                !command.name ||
                !command.execute
            ) {

                console.log(
                    `⚠️ Command übersprungen: ${entry.name}`
                );

                continue;
            }

            command.category =
                category || 'Sonstiges';

            commands[
                command.name
            ] = command;

            if (
                Array.isArray(
                    command.aliases
                )
            ) {

                for (
                    const alias of
                    command.aliases
                ) {

                    commands[
                        alias
                    ] = command;
                }
            }

            console.log(
                `✅ Command geladen: ${command.name} [${command.category}]`
            );

        } catch (error) {

            console.error(
                `❌ Fehler beim Laden von ${entry.name}:`,
                error
            );
        }
    }
}

loadCommandFiles(
    commandsPath
);

global.commands =
    commands;


// =========================
// TERMINAL-COMMANDS
// =========================

let terminalInputStarted = false;

function startTerminalCommands(
    sock
) {

    if (terminalInputStarted) {
        return;
    }

    terminalInputStarted = true;

    const terminal =
        readline.createInterface({
            input: process.stdin,
            output: process.stdout
        });

    console.log(
        '💻 Terminal-Commands aktiviert: !ping | !restart'
    );

    terminal.on(
        'line',
        async input => {

            const text =
                input.trim();

            if (!text) {
                return;
            }

            if (
                text !== '!ping' &&
                text !== '!restart'
            ) {
                return;
            }

            const commandName =
                text
                    .slice(1)
                    .trim()
                    .split(/\s+/)[0]
                    .toLowerCase();

            const command =
                commands[commandName];

            if (!command) {
                return;
            }

            console.log(
                `💻 Terminal Command: ${text}`
            );

            const ownJid =
                sock.user?.id;

            if (!ownJid) {

                console.error(
                    '❌ Terminal Command nicht möglich: WhatsApp-ID nicht verfügbar.'
                );

                return;
            }

            const terminalMessage = {

                key: {
                    remoteJid: ownJid,
                    fromMe: true,
                    id: `TERMINAL-${Date.now()}`,
                    participant: ownJid
                },

                message: {
                    conversation: text
                }
            };

            try {

                await command.execute({

                    sock,

                    message:
                        terminalMessage,

                    text:
                        text.slice(1).trim(),

                    senderRank: 3,

                    ranks:
                        loadRanks(),

                    saveRanks,

                    react
                });

            } catch (error) {

                console.error(
                    `❌ Fehler beim Terminal Command ${command.name}:`,
                    error
                );

                await react(
                    sock,
                    terminalMessage,
                    '❌'
                );
            }
        }
    );
}


// =========================
// WHATSAPP
// =========================

async function startBot() {

    const {
        state,
        saveCreds
    } =
        await useMultiFileAuthState(
            './auth'
        );

    const sock =
        makeWASocket({

            auth: state,

            logger: pino({
                level: 'silent'
            })
        });


    // =========================
    // LOOK-NACHRICHTEN CACHE
    // =========================

    const lookCacheFile =
        path.join(
            __dirname,
            'lookMessageCache.bin'
        );

    const lookMessageCache =
        new Map();

    try {

        if (fs.existsSync(lookCacheFile)) {

            const storedCache =
                v8.deserialize(
                    fs.readFileSync(
                        lookCacheFile
                    )
                );

            if (storedCache instanceof Map) {

                for (
                    const [
                        key,
                        cachedMessage
                    ]
                    of storedCache
                ) {

                    lookMessageCache.set(
                        key,
                        cachedMessage
                    );
                }
            }
        }

    } catch (error) {

        console.error(
            '⚠️ !look: Gespeicherter Nachrichten-Cache konnte nicht geladen werden:',
            error
        );
    }

    function getLookCacheKey(key) {

        if (
            !key?.remoteJid ||
            !key?.id
        ) {
            return null;
        }

        return (
            `${key.remoteJid}|${key.id}`
        );
    }

    function saveLookMessageCache() {

        try {

            fs.writeFileSync(
                lookCacheFile,
                v8.serialize(
                    lookMessageCache
                )
            );

        } catch (error) {

            console.error(
                '⚠️ !look: Nachrichten-Cache konnte nicht gespeichert werden:',
                error
            );
        }
    }

    function cacheLookMessage(
        message
    ) {

        const key =
            getLookCacheKey(
                message?.key
            );

        if (!key) {
            return;
        }

        const content =
            message?.message;

        const hasImage =
            Boolean(
                content?.imageMessage ||
                content?.viewOnceMessage
                    ?.message
                    ?.imageMessage ||
                content?.viewOnceMessageV2
                    ?.message
                    ?.imageMessage ||
                content?.viewOnceMessageV2Extension
                    ?.message
                    ?.imageMessage ||
                content?.ephemeralMessage
                    ?.message
                    ?.imageMessage
            );

        const hasVideo =
            Boolean(
                content?.videoMessage ||
                content?.viewOnceMessage
                    ?.message
                    ?.videoMessage ||
                content?.viewOnceMessageV2
                    ?.message
                    ?.videoMessage ||
                content?.viewOnceMessageV2Extension
                    ?.message
                    ?.videoMessage ||
                content?.ephemeralMessage
                    ?.message
                    ?.videoMessage
            );

        if (
            !hasImage &&
            !hasVideo
        ) {
            return;
        }

        lookMessageCache.set(
            key,
            message
        );

        while (
            lookMessageCache.size > 500
        ) {

            const firstKey =
                lookMessageCache
                    .keys()
                    .next()
                    .value;

            if (!firstKey) {
                break;
            }

            lookMessageCache.delete(
                firstKey
            );
        }

        saveLookMessageCache();
    }

    function findCachedMessage(
        key
    ) {

        const cacheKey =
            getLookCacheKey(
                key
            );

        if (!cacheKey) {
            return null;
        }

        return (
            lookMessageCache.get(
                cacheKey
            ) ||
            null
        );
    }


    sock.ev.on(
        'creds.update',
        saveCreds
    );


    // =========================
    // VERBINDUNG
    // =========================

    sock.ev.on(
        'connection.update',
        update => {

            const {
                connection,
                lastDisconnect,
                qr
            } = update;


            if (qr) {

                console.log(
                    '📱 QR-Code scannen:'
                );

                qrcode.generate(
                    qr,
                    {
                        small: true
                    }
                );
            }


            if (
                connection === 'open'
            ) {

                console.log(
                    '✅ WhatsApp verbunden!'
                );

                console.log(
                    '🤖 Bot gestartet – v1.30'
                );

                finishRestartReaction(
                    sock
                );

                startTerminalCommands(
                    sock
                );
            }


            if (
                connection === 'close'
            ) {

                const shouldReconnect =
                    lastDisconnect
                        ?.error
                        ?.output
                        ?.statusCode !==
                    DisconnectReason.loggedOut;


                console.log(
                    '❌ Verbindung geschlossen.'
                );


                if (
                    shouldReconnect
                ) {

                    console.log(
                        '🔄 Verbindung wird neu aufgebaut...'
                    );

                    startBot();
                }
            }
        }
    );


    // =========================
    // NACHRICHTEN
    // =========================

    sock.ev.on(
        'messages.upsert',
        async ({
            messages
        }) => {

            const message =
                messages[0];

            if (!message) {
                return;
            }


            const remoteJid =
                message.key.remoteJid;

            if (!remoteJid) {
                return;
            }


            // =========================
            // LOOK-CACHE AKTUALISIEREN
            // =========================

            for (
                const incomingMessage
                of messages
            ) {

                cacheLookMessage(
                    incomingMessage
                );
            }


            // =========================
            // TEXT HOLEN
            // =========================

            const text =
                message.message
                    ?.conversation ||
                message.message
                    ?.extendedTextMessage
                    ?.text ||
                message.message
                    ?.imageMessage
                    ?.caption ||
                message.message
                    ?.videoMessage
                    ?.caption ||
                '';

            if (!text) {
                return;
            }


            // =========================
            // RÄNGE
            // =========================

            const ranks =
                loadRanks();


            const rawSenderLid =
                message.key.participant ||
                message.key.remoteJid;


            const senderLid =
                normalizeLid(
                    rawSenderLid
                );


            const senderRank =
                Number(
                    ranks[senderLid] ??
                    ranks[rawSenderLid] ??
                    0
                );


            const isGroup =
                remoteJid.endsWith(
                    '@g.us'
                );


            // =========================
            // PRIVATE NACHRICHTEN
            // NUR RANG 3+
            //
            // Ausnahme:
            // Der eigene Account darf !look / !l
            // auch privat benutzen.
            // =========================

            const isOwnPrivateMessage =
                !isGroup &&
                message.key.fromMe === true;

            if (
                !isGroup &&
                !isOwnPrivateMessage &&
                senderRank < 3
            ) {
                return;
            }


            // =========================
            // RANG 0 IGNORIEREN
            // =========================

            if (
                senderRank < 1 &&
                !isOwnPrivateMessage
            ) {
                return;
            }


            // =========================
            // PREFIX
            // =========================

            const globalPrefix =
                loadPrefix();

            const groupPrefixes =
                loadGroupPrefixes();


            const PREFIX =
                isGroup &&
                groupPrefixes[
                    remoteJid
                ]
                    ? groupPrefixes[
                        remoteJid
                    ]
                    : globalPrefix;


            // =========================
            // PREFIX PRÜFEN
            // =========================

            if (
                !text.startsWith(
                    PREFIX
                )
            ) {
                return;
            }


            // =========================
            // COMMAND PARSEN
            // =========================

            const withoutPrefix =
                text
                    .slice(
                        PREFIX.length
                    )
                    .trim();


            if (!withoutPrefix) {
                return;
            }


            const parts =
                withoutPrefix
                    .split(/\s+/);


            const commandName =
                parts[0]
                    .toLowerCase();


            // =========================
            // PRIVATE !LOOK
            // NUR DER EIGENE ACCOUNT
            // =========================

            if (
                isOwnPrivateMessage &&
                commandName !== 'look' &&
                commandName !== 'l'
            ) {
                return;
            }


            // =========================
            // KILL SYSTEM
            // =========================

            const killedGroups =
                loadKilledGroups();


            if (
                isGroup &&
                killedGroups[
                    remoteJid
                ] === true &&
                commandName !== 'kill'
            ) {

                return;
            }


            // =========================
            // GLOBAL KILL
            // =========================

            const globalKill =
                loadGlobalKill();

            if (
                globalKill.enabled === true &&
                commandName !== 'globalkill' &&
                commandName !== 'gb'
            ) {
                return;
            }


            // =========================
            // COMMAND SUCHEN
            // =========================

            const command =
                commands[
                    commandName
                ];


            if (!command) {

                await react(
                    sock,
                    message,
                    '❓'
                );

                return;
            }


            // =========================
            // TELEFONNUMMER
            // =========================

            const phoneNumber =
                await getPhoneNumber(
                    sock,
                    message,
                    senderLid
                );


            // =========================
            // COMMAND LOG
            // =========================

            console.log(
                `📨 Command: ${PREFIX}${withoutPrefix} | Rang: ${senderRank} | LID: ${senderLid} | Nummer: ${phoneNumber}`
            );


            // =========================
            // ONLYOWNER
            // =========================

            const onlyOwner =
                loadOnlyOwner();

            const onlyOwnerActive =
                isGroup &&
                onlyOwner[
                    remoteJid
                ] === true;

            if (
                onlyOwnerActive &&
                command.name !== 'onlyowner' &&
                senderRank < 2
            ) {

                await react(
                    sock,
                    message,
                    '2️⃣'
                );

                return;
            }

            if (
                onlyOwnerActive &&
                command.name !== 'onlyowner' &&
                senderRank < 2
            ) {

                let metadata;

                try {

                    metadata =
                        await sock.groupMetadata(
                            remoteJid
                        );

                } catch {

                    return;
                }

                function normalizeOwnerId(
                    value
                ) {

                    if (!value) {
                        return '';
                    }

                    return String(value)
                        .split(':')[0]
                        .split('@')[0]
                        .replace(/\D/g, '');
                }

                const senderId =
                    normalizeOwnerId(
                        senderLid
                    );

                const senderPhone =
                    normalizeOwnerId(
                        phoneNumber
                    );

                const ownerId =
                    normalizeOwnerId(
                        metadata?.owner
                    );

                const ownerPhone =
                    normalizeOwnerId(
                        metadata?.ownerPn
                    );

                const isOwner =
                    (
                        senderId &&
                        ownerId &&
                        senderId === ownerId
                    ) ||
                    (
                        senderPhone &&
                        ownerPhone &&
                        senderPhone === ownerPhone
                    );

                if (!isOwner) {

                    await react(
                        sock,
                        message,
                        '2️⃣'
                    );

                    return;
                }
            }


            // =========================
            // WARTUNG
            // =========================

            const maintenance =
                loadMaintenance();


            if (
                maintenance[
                    command.name
                ] === true &&
                command.name !== 'wartung'
            ) {

                await react(
                    sock,
                    message,
                    '🔧'
                );

                return;
            }


            // =========================
            // COMMAND AUSFÜHREN
            // =========================

            try {

                await command.execute({

                    sock,

                    message,

                    text:
                        withoutPrefix,

                    senderRank,

                    ranks,

                    saveRanks,

                    phoneNumber,

                    react,

                    findCachedMessage
                });

            } catch (error) {

                console.error(
                    `❌ Fehler bei Command ${command.name}:`,
                    error
                );


                await react(
                    sock,
                    message,
                    '❌'
                );
            }
        }
    );
}


// =========================
// BOT STARTEN
// =========================

startBot();
