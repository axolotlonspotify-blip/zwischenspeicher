const path = require('path');
const pino = require('pino');
const readline = require('readline');


// =========================
// SESSION-LOGS AUSBLENDEN
// =========================

const originalConsoleLog = console.log;
const originalConsoleError = console.error;
const originalConsoleWarn = console.warn;

function shouldHideSessionLog(args) {

    const text = args
        .map(arg => {

            if (typeof arg === 'string') {
                return arg;
            }

            try {
                return JSON.stringify(arg);
            } catch {
                return String(arg);
            }
        })
        .join(' ');

    return (
        text.includes('Closing session: SessionEntry') ||
        text.includes(
            'Closing stale open session for new outgoing prekey bundle'
        ) ||
        text.includes(
            'Closing open session in favor of incoming prekey bundle'
        ) ||
        text.includes(
            'Removing old closed session'
        ) ||
        text.includes(
            'Decrypted message with closed session'
        )
    );
}


// =========================
// CONSOLE FILTER
// =========================

console.log = (...args) => {

    if (shouldHideSessionLog(args)) {
        return;
    }

    originalConsoleLog(...args);
};

console.error = (...args) => {

    if (shouldHideSessionLog(args)) {
        return;
    }

    originalConsoleError(...args);
};

console.warn = (...args) => {

    if (shouldHideSessionLog(args)) {
        return;
    }

    originalConsoleWarn(...args);
};


// =========================
// DIREKTEN STDOUT/STDERR
// FILTERN
// =========================

const originalStdoutWrite =
    process.stdout.write.bind(
        process.stdout
    );

const originalStderrWrite =
    process.stderr.write.bind(
        process.stderr
    );

function shouldHideRawSessionLog(chunk) {

    if (
        typeof chunk !== 'string' &&
        !Buffer.isBuffer(chunk)
    ) {
        return false;
    }

    const text =
        Buffer.isBuffer(chunk)
            ? chunk.toString()
            : chunk;

    return (
        text.includes(
            'Closing session: SessionEntry'
        ) ||
        text.includes(
            'Closing stale open session for new outgoing prekey bundle'
        ) ||
        text.includes(
            'Closing open session in favor of incoming prekey bundle'
        ) ||
        text.includes(
            'Removing old closed session'
        ) ||
        text.includes(
            'Decrypted message with closed session'
        )
    );
}

process.stdout.write = function (
    chunk,
    encoding,
    callback
) {

    if (
        shouldHideRawSessionLog(
            chunk
        )
    ) {

        if (
            typeof callback ===
            'function'
        ) {
            callback();
        }

        return true;
    }

    return originalStdoutWrite(
        chunk,
        encoding,
        callback
    );
};

process.stderr.write = function (
    chunk,
    encoding,
    callback
) {

    if (
        shouldHideRawSessionLog(
            chunk
        )
    ) {

        if (
            typeof callback ===
            'function'
        ) {
            callback();
        }

        return true;
    }

    return originalStderrWrite(
        chunk,
        encoding,
        callback
    );
};


// =========================
// DATEIEN LADEN
// =========================

function loadRanks() {

    try {

        return JSON.parse(
            fs.readFileSync(
                './ranks.json',
                'utf8'
            )
        );

    } catch {

        return {};
    }
}

function saveRanks(ranks) {

    fs.writeFileSync(
        './ranks.json',
        JSON.stringify(
            ranks,
            null,
            2
        ),
        'utf8'
    );
}

function loadPrefix() {

    try {

        const data = JSON.parse(
            fs.readFileSync(
                './prefix.json',
                'utf8'
            )
        );

        if (
            typeof data.prefix === 'string' &&
            data.prefix.length > 0
        ) {
            return data.prefix;
        }

        return '!';

    } catch {

        return '!';
    }
}

